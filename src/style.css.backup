/* ============================================================
   Circuleather Leeropslag — vormgeving (v6)
   Mobiel-eerst app-ontwerp in de merkidentiteit van circuleather.com:
   Poppins, bijna-zwart, koraal als accent. Telefoon krijgt een
   echte app-ervaring: onderste navigatiebalk, zwevende actieknop,
   grotere knoppen, installeerbaar (PWA). Laptop houdt de strakke
   boven-navigatie en tabellen.
   ============================================================ */

@font-face {
    font-family: "Poppins";
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url("fonts/poppins-400.woff2") format("woff2");
}
@font-face {
    font-family: "Poppins";
    font-style: normal;
    font-weight: 600;
    font-display: swap;
    src: url("fonts/poppins-600.woff2") format("woff2");
}
@font-face {
    font-family: "Poppins";
    font-style: normal;
    font-weight: 700;
    font-display: swap;
    src: url("fonts/poppins-700.woff2") format("woff2");
}

:root {
    --bg: #f1ece2;
    --oppervlak: #fffdf8;
    --oppervlak-2: #f8f3e9;
    --lijn: #e2dac9;
    --lijn-sterk: #c9bea8;
    --inkt: #1f1810;
    --tekst: #42392c;
    --mild: #7a6e5a;
    --leer: #e95a44;
    --leer-donker: #c93d28;
    --leer-zacht: #fdeeea;
    --bruin: #7d5230;
    --bruin-zacht: #f3e7d8;
    --groen: #2f7d52;
    --groen-zacht: #e6f4ec;
    --amber: #8a6416;
    --amber-zacht: #faf0da;
    --blauw: #2b5fbf;
    --blauw-zacht: #e8eefb;
    --rood: #b23b28;
    --rood-zacht: #fbe9e5;
    --schaduw: 0 1px 2px rgba(29, 26, 22, .05), 0 12px 32px -20px rgba(29, 26, 22, .30);
    --schaduw-hoog: 0 4px 10px rgba(29, 26, 22, .10), 0 24px 50px -24px rgba(29, 26, 22, .40);
    --radius: 16px;
    --radius-klein: 10px;
    --bodemhoogte: calc(62px + env(safe-area-inset-bottom, 0px));
}

* { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; }
::selection { background: rgba(238, 90, 72, .22); }

body {
    margin: 0 auto;
    max-width: 1120px;
    padding: 0 16px calc(84px + env(safe-area-inset-bottom, 0px));
    color: var(--tekst);
    font-family: "Poppins", system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    font-size: 16px;
    line-height: 1.6;
    background:
        radial-gradient(1100px 520px at 85% -10%, rgba(214, 110, 60, .07), transparent 60%),
        radial-gradient(900px 520px at -10% 110%, rgba(125, 82, 48, .06), transparent 55%),
        var(--bg);
    background-attachment: fixed;
    -webkit-tap-highlight-color: transparent;
}
/* Subtiele leer-grein over de hele achtergrond */
body::before {
    content: "";
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    opacity: .055;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='180' height='180'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.7' numOctaves='2' stitchTiles='stitch'/><feColorMatrix type='saturate' values='0'/></filter><rect width='180' height='180' filter='url(%23n)' opacity='0.6'/></svg>");
    background-size: 180px 180px;
}
body.smal { max-width: 780px; }
@media (min-width: 900px) {
    body { padding-bottom: 52px; }
}

/* --- Typografie --- */
h1, h2 {
    font-family: "Poppins", system-ui, sans-serif;
    font-weight: 700;
    color: var(--inkt);
    line-height: 1.18;
    letter-spacing: -.01em;
}
h1 {
    font-size: clamp(24px, 5vw, 32px);
    margin: 22px 0 6px;
}
h1 small {
    display: block;
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: .02em;
    color: var(--mild);
    margin-top: 3px;
}
h1::after {
    content: "";
    display: block;
    width: 44px;
    height: 4px;
    border-radius: 99px;
    margin-top: 10px;
    background: var(--leer);
}
h2 {
    font-size: 17.5px;
    margin: 26px 0 10px;
}
h2 small { color: var(--leer); font-weight: 600; }
a { color: var(--leer-donker); }
.back-link {
    display: inline-block;
    margin: 14px 0 0;
    font-size: 13px;
    font-weight: 600;
    color: var(--mild);
    text-decoration: none;
}
.back-link:hover { color: var(--leer-donker); }

/* "Live" stipje op pagina's die automatisch bijwerken */
.live-stip {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--groen);
    margin-right: 6px;
    vertical-align: 1px;
    box-shadow: 0 0 0 0 rgba(47, 125, 82, .45);
    animation: livepuls 2.2s infinite;
}
@keyframes livepuls {
    0% { box-shadow: 0 0 0 0 rgba(47, 125, 82, .45); }
    70% { box-shadow: 0 0 0 8px rgba(47, 125, 82, 0); }
    100% { box-shadow: 0 0 0 0 rgba(47, 125, 82, 0); }
}
/* Live-updates liggen even stil (geen verbinding / sessie verlopen) */
.live-stip.live-onderbroken {
    background: var(--mild);
    animation: none;
    box-shadow: none;
}

/* Installatie-banner (PWA): verschijnt zodra de browser de app installeerbaar vindt */
.pwa-banner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
    max-width: 1100px;
    width: calc(100% - 32px);
    margin: 0 auto 18px;
    padding: 12px 16px;
    background: linear-gradient(135deg, #241c14, #38291b);
    color: #fdf6ec;
    border: 1px solid rgba(238, 90, 72, .4);
    border-radius: 14px;
    box-shadow: var(--schaduw);
}
.pwa-banner[hidden] { display: none; }
.pwa-banner-icoon { font-size: 24px; line-height: 1; }
.pwa-banner-tekst { flex: 1 1 220px; min-width: 0; }
.pwa-banner-tekst strong { display: block; font-size: 14px; font-weight: 600; }
.pwa-banner-tekst small { display: block; color: #d9c9af; font-size: 12px; margin-top: 2px; }
.pwa-banner-knoppen { display: flex; align-items: center; gap: 4px; }
.pwa-banner .pwa-installeer {
    background: var(--leer);
    color: #fff;
    border: 0;
    font: 600 14px Poppins, system-ui, sans-serif;
    padding: 10px 18px;
    border-radius: 10px;
    cursor: pointer;
    min-height: 44px;
}
.pwa-banner .pwa-installeer:active { background: var(--leer-donker); }
.pwa-banner .pwa-later {
    background: none;
    border: 0;
    color: #cbbc9f;
    font: 500 13px Poppins, system-ui, sans-serif;
    cursor: pointer;
    padding: 10px 8px;
    min-height: 44px;
    border-radius: 10px;
}
.pwa-banner .pwa-later:hover { color: #fdf6ec; }

/* --- Header / navigatie --- */
.sitekop {
    position: sticky;
    top: 0;
    z-index: 60;
    margin: 0 -16px 6px;
    padding: 10px 16px 8px;
    background: rgba(255, 255, 255, .9);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--lijn);
}
.sitekop-boven {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
}
.merk {
    display: inline-flex;
    flex-direction: column;
    gap: 3px;
    font-family: "Poppins", sans-serif;
    font-size: 18px;
    font-weight: 700;
    letter-spacing: .05em;
    text-transform: uppercase;
    color: var(--inkt);
    text-decoration: none;
    line-height: 1;
}
.merk .tagline {
    font-size: 8.5px;
    font-weight: 600;
    letter-spacing: .28em;
    text-transform: uppercase;
    color: var(--mild);
}
.merk .hart { color: var(--leer); }
.gebruiker-zone { display: flex; align-items: center; gap: 4px; }
.gebruiker-zone a {
    text-decoration: none;
    font-size: 12.5px;
    font-weight: 600;
    padding: 8px 10px;
    border-radius: 999px;
    white-space: nowrap;
}
.gebruiker-zone .gebruiker { color: var(--tekst); }
.gebruiker-zone .gebruiker:hover { background: var(--oppervlak-2); color: var(--leer-donker); }
.gebruiker-zone .uitloggen { color: var(--rood); font-size: 12px; }
.gebruiker-zone .uitloggen:hover { background: var(--rood-zacht); }

/* Desktop-navigatiebalk (boven) */
.topnav {
    display: none;
    gap: 4px;
    margin-top: 10px;
    overflow-x: auto;
    scrollbar-width: none;
}
.topnav::-webkit-scrollbar { display: none; }
.topnav a {
    position: relative;
    white-space: nowrap;
    padding: 9px 13px;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--tekst);
    text-decoration: none;
    border-radius: 9px;
    transition: color .12s ease, background .12s ease;
}
.topnav a:hover { color: var(--leer-donker); background: var(--leer-zacht); }
.topnav a.actief { color: var(--inkt); }
.topnav a.actief::after {
    content: "";
    position: absolute;
    left: 13px;
    right: 13px;
    bottom: 3px;
    height: 2.5px;
    border-radius: 2px;
    background: var(--leer);
}
@media (min-width: 900px) {
    .topnav { display: flex; }
}

/* Mobiele onderste navigatiebalk (app-gevoel) */
.bodem-nav {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 90;
    display: flex;
    background: rgba(255, 255, 255, .96);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-top: 1px solid var(--lijn);
    padding: 5px 6px env(safe-area-inset-bottom, 0px);
    box-shadow: 0 -10px 30px -20px rgba(29, 26, 22, .30);
}
.bodem-nav a {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    padding: 6px 2px 5px;
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: .01em;
    color: var(--mild);
    text-decoration: none;
    border-radius: 12px;
    position: relative;
}
.bodem-nav a svg { width: 23px; height: 23px; }
.bodem-nav a span { line-height: 1.1; }
.bodem-nav a.actief { color: var(--leer-donker); }
.bodem-nav a.actief::before {
    content: "";
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 30px;
    height: 3px;
    border-radius: 3px;
    background: var(--leer);
}
.bodem-nav a:active { background: var(--leer-zacht); }
@media (min-width: 900px) {
    .bodem-nav { display: none; }
}

/* --- Knoppen (touch-vriendelijk) --- */
.knoppen { display: flex; flex-wrap: wrap; gap: 10px; margin: 16px 0 20px; }
button, .knoppen a, .knoppen button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 46px;
    padding: 11px 18px;
    background: var(--leer);
    color: #fff;
    border: 1px solid transparent;
    border-radius: var(--radius-klein);
    font-family: inherit;
    font-size: 14.5px;
    font-weight: 600;
    line-height: 1.25;
    text-decoration: none;
    cursor: pointer;
    box-shadow: 0 1px 2px rgba(29, 26, 22, .08);
    transition: background .12s ease, border-color .12s ease, transform .05s ease;
}
button:hover, .knoppen a:hover, .knoppen button:hover { background: var(--leer-donker); }
button:active, .knoppen a:active, .knoppen button:active { transform: translateY(1px); }
button:focus-visible, .knoppen a:focus-visible, .knoppen button:focus-visible {
    outline: 2px solid var(--leer);
    outline-offset: 2px;
}
button.secondary, .knoppen a.secondary, .knoppen button.secondary {
    background: var(--oppervlak);
    color: var(--inkt);
    border-color: var(--lijn-sterk);
    box-shadow: none;
}
button.secondary:hover, .knoppen a.secondary:hover, .knoppen button.secondary:hover {
    background: var(--oppervlak);
    border-color: var(--leer);
    color: var(--leer-donker);
}
button[type="submit"] { margin-top: 18px; width: 100%; }
form .knoppen button[type="submit"] { margin-top: 0; width: auto; }
@media (min-width: 640px) {
    button[type="submit"] { width: auto; min-width: 180px; }
}
@media (min-width: 761px) {
    .knoppen a, .knoppen button { flex: 0 0 auto; }
}

/* Op de telefoon: toevoegen via de zwevende knop, niet via deze rij */
.toevoegen-rij { transition: opacity .2s ease; }
@media (max-width: 899px) {
    .toevoegen-rij { display: none; }
}

/* --- Zwevende actieknop (FAB) --- */
.fab {
    position: fixed;
    right: 18px;
    bottom: calc(var(--bodemhoogte) + 14px);
    z-index: 80;
    display: none;
    flex-direction: column;
    align-items: flex-end;
    gap: 10px;
}
.fab-knop {
    width: 58px;
    height: 58px;
    min-height: 0;
    border-radius: 50%;
    background: var(--leer);
    color: #fff;
    font-size: 30px;
    font-weight: 400;
    line-height: 1;
    padding: 0;
    border: 0;
    box-shadow: 0 10px 26px -6px rgba(238, 90, 72, .55);
}
.fab-knop:hover { background: var(--leer-donker); }
.fab-knop:active { transform: scale(.94); }
.fab-items {
    display: none;
    flex-direction: column;
    gap: 8px;
    align-items: flex-end;
}
.fab.open .fab-items { display: flex; }
.fab-items a {
    background: var(--oppervlak);
    color: var(--inkt);
    border: 1px solid var(--lijn);
    border-radius: 999px;
    padding: 11px 16px;
    font-size: 13.5px;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    box-shadow: var(--schaduw-hoog);
    animation: fab-in .15s ease;
}
.fab-items a:hover { color: var(--leer-donker); border-color: var(--leer); }
@keyframes fab-in { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
@media (max-width: 899px) {
    .fab { display: flex; }
}

/* --- Meldingen: succes als toast (verdwijnt vanzelf) --- */
.msg {
    position: fixed;
    top: calc(12px + env(safe-area-inset-top, 0px));
    left: 50%;
    transform: translateX(-50%);
    z-index: 200;
    width: max-content;
    max-width: calc(100vw - 28px);
    background: var(--groen-zacht);
    border: 1px solid #bfe0cd;
    color: #245f3a;
    border-radius: 999px;
    padding: 11px 20px;
    font-size: 13.5px;
    font-weight: 600;
    text-align: center;
    box-shadow: var(--schaduw-hoog);
    animation: toast-in .25s ease;
}
@keyframes toast-in { from { opacity: 0; transform: translate(-50%, -10px); } to { opacity: 1; transform: translate(-50%, 0); } }
.msg.verdwijn { opacity: 0; transform: translate(-50%, -12px); transition: all .35s ease; }

.fout, .errors {
    padding: 11px 14px;
    border-radius: var(--radius-klein);
    margin: 12px 0 14px;
    font-size: 13.5px;
    background: var(--rood-zacht);
    border: 1px solid #f0c9c1;
    color: var(--rood);
}
.errors ul, .fout ul { margin: 0; padding-left: 20px; }

/* --- Statistiek-boxen --- */
.stat-rij {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    margin: 18px 0;
}
@media (min-width: 640px) { .stat-rij { grid-template-columns: repeat(4, 1fr); } }
.stat {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 2px;
    background: var(--oppervlak);
    border: 1px solid var(--lijn);
    border-radius: var(--radius);
    padding: 13px 14px;
    box-shadow: var(--schaduw);
}
.stat-icoon {
    position: absolute;
    top: 12px;
    right: 13px;
    font-size: 19px;
    opacity: .65;
}
.stat-label {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: .09em;
    text-transform: uppercase;
    color: var(--mild);
    padding-right: 24px;
}
.stat-waarde {
    font-size: 27px;
    font-weight: 700;
    line-height: 1.12;
    color: var(--inkt);
}

/* --- Tabellen --- */
table {
    width: 100%;
    border-collapse: collapse;
    background: var(--oppervlak);
    border: 1px solid var(--lijn);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--schaduw);
}
th {
    background: #f5f3ee;
    color: #5d564b;
    text-align: left;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: .07em;
    text-transform: uppercase;
    padding: 11px 14px;
    border-bottom: 1px solid var(--lijn);
    white-space: nowrap;
}
td {
    padding: 12px 14px;
    border-bottom: 1px solid #f0ede6;
    font-size: 14px;
    vertical-align: top;
}
tbody tr:last-child td { border-bottom: 0; }
tbody tr { transition: background .1s ease; }
tbody tr:hover td { background: var(--oppervlak-2); }
td.kenmerken { color: var(--mild); font-size: 13px; }
td.kenmerken strong { color: var(--inkt); }
td.acties { white-space: nowrap; }
td.acties a {
    font-weight: 600;
    font-size: 13px;
    margin-right: 12px;
    text-decoration: none;
}
td.acties a:hover { text-decoration: underline; }
td.acties a.wissen { color: var(--rood); }
.lege-tabel { text-align: center; color: var(--mild); padding: 34px 14px !important; }
.inactief { color: var(--mild); }
.lege-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
}
.lege-inner .lege-icoon { font-size: 36px; line-height: 1; }
.lege-inner p { margin: 0; font-size: 14px; }
.lege-inner a {
    margin-top: 4px;
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    padding: 10px 18px;
    background: var(--leer);
    color: #fff;
    border-radius: var(--radius-klein);
    font-size: 13.5px;
    font-weight: 600;
    text-decoration: none;
}
.lege-inner a:hover { background: var(--leer-donker); }

/* Mobiel: rijen als kaarten */
.rij-chevron { display: none; }
@media (max-width: 760px) {
    table, tbody, tr { display: block; width: 100%; }
    thead { display: none; }
    table { border: 0; background: transparent; box-shadow: none; }
    tr {
        background: var(--oppervlak);
        border: 1px solid var(--lijn);
        border-left: 4px solid var(--lijn-sterk);
        border-radius: var(--radius);
        padding: 3px 2px;
        margin-bottom: 12px;
        box-shadow: var(--schaduw);
    }
    tr.rij-bigbag { border-left-color: var(--leer); }
    tr.rij-leersample { border-left-color: var(--bruin); }
    td {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 14px;
        border: 0;
        border-bottom: 1px dashed var(--lijn);
        padding: 9px 12px;
    }
    td:last-child { border-bottom: 0; }
    td::before {
        content: attr(data-label);
        flex: 0 0 auto;
        font-size: 10px;
        font-weight: 600;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: var(--mild);
        padding-top: 3px;
    }
    td:first-child { padding-top: 13px; padding-bottom: 8px; }
    td:first-child::before { display: none; }
    td:first-child {
        font-size: 15.5px;
        font-weight: 700;
        color: var(--inkt);
        letter-spacing: .01em;
    }
    .rij-chevron {
        display: inline-block;
        margin-left: auto;
        font-size: 21px;
        color: var(--mild);
        text-decoration: none;
        line-height: 1;
    }
    td.kenmerken, td.acties { display: flex; flex-direction: column; align-items: stretch; }
    td.kenmerken::before, td.acties::before { margin-bottom: 5px; }
    td.kenmerken div, td.acties a { flex: none; }
    td.acties a {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 44px;
        margin: 4px 0 0;
        padding: 10px;
        background: var(--oppervlak-2);
        border: 1px solid var(--lijn);
        border-radius: var(--radius-klein);
        color: var(--inkt);
    }
    td.acties a:hover { text-decoration: none; }
    td.acties a.wissen { background: var(--rood-zacht); border-color: #f0c9c1; color: var(--rood); }
    .lege-tabel { display: block; }
}

/* --- Badges --- */
.badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 11px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 600;
    white-space: nowrap;
}
.badge::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    opacity: .9;
}
.badge.beschikbaar { background: var(--groen-zacht); color: var(--groen); }
.badge.gereserveerd { background: var(--amber-zacht); color: var(--amber); }
.badge.in_bewerking { background: var(--blauw-zacht); color: var(--blauw); }
.badge.verkocht { background: #ece7dd; color: #5c554a; }
.badge.admin { background: var(--inkt); color: #fff; }
.badge.medewerker { background: var(--blauw-zacht); color: var(--blauw); }

/* --- Formulieren --- */
form {
    background: var(--oppervlak);
    padding: clamp(16px, 3vw, 26px);
    border: 1px solid var(--lijn);
    border-radius: var(--radius);
    box-shadow: var(--schaduw);
    max-width: 680px;
}
label {
    display: block;
    margin-top: 16px;
    font-size: 13px;
    font-weight: 600;
    color: var(--inkt);
}
input[type="text"], input[type="email"], input[type="password"], input[type="search"],
input[type="number"], input[type="date"], select, textarea {
    width: 100%;
    margin-top: 6px;
    padding: 12px 13px;
    background: #fff;
    border: 1px solid var(--lijn-sterk);
    border-radius: var(--radius-klein);
    font-size: 16px;
    font-family: inherit;
    color: var(--inkt);
    transition: border-color .12s ease, box-shadow .12s ease;
}
input:focus, select:focus, textarea:focus {
    outline: none;
    border-color: var(--leer);
    box-shadow: 0 0 0 3px rgba(238, 90, 72, .15);
}
select { appearance: auto; }
.radio-row { display: grid; grid-template-columns: 1fr; gap: 8px; margin-top: 6px; }
@media (min-width: 480px) { .radio-row { grid-template-columns: 1fr 1fr; } }
.radio-row label {
    margin: 0;
    padding: 13px 14px;
    border: 1px solid var(--lijn-sterk);
    border-radius: var(--radius-klein);
    background: #fff;
    cursor: pointer;
    font-weight: 600;
    font-size: 13.5px;
    color: var(--tekst);
    transition: border-color .12s ease, background .12s ease;
}
.radio-row label:has(input:checked) {
    border-color: var(--leer);
    background: var(--leer-zacht);
    color: var(--inkt);
}
.checkbox-rij { display: flex; align-items: center; gap: 10px; margin-top: 16px; font-weight: 600; font-size: 13.5px; }
.checkbox-rij input { width: 18px; height: 18px; accent-color: var(--leer); }
label.optie { display: inline-block; margin: 6px 16px 0 0; font-weight: 400; font-size: 14px; }
fieldset {
    margin-top: 18px;
    border: 1px solid var(--lijn);
    background: var(--oppervlak-2);
    border-radius: var(--radius);
    padding: 12px 16px 18px;
}
legend {
    font-weight: 700;
    font-size: 13px;
    color: var(--inkt);
    padding: 0 8px;
    letter-spacing: .02em;
}
.hint, .meta { color: var(--mild); font-size: 13px; margin: 4px 0 10px; }
.meta strong { color: var(--tekst); }
code {
    background: #f0ece4;
    padding: 1px 7px;
    border-radius: 6px;
    font-size: .92em;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
}

/* Vaste opslaan-balk onderaan een lang formulier (telefoon) */
.form-acties {
    display: flex;
    gap: 10px;
    position: sticky;
    bottom: calc(var(--bodemhoogte) + 10px);
    z-index: 40;
    margin-top: 24px;
    padding: 12px;
    background: rgba(255, 255, 255, .94);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--lijn);
    border-radius: 14px;
    box-shadow: var(--schaduw-hoog);
}
.form-acties a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 10px 16px;
    background: var(--oppervlak);
    color: var(--inkt);
    border: 1px solid var(--lijn-sterk);
    border-radius: var(--radius-klein);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
}
.form-acties a:hover { border-color: var(--leer); color: var(--leer-donker); }
.form-acties button {
    flex: 1;
    margin: 0;
    min-height: 46px;
}
@media (min-width: 900px) {
    .form-acties { bottom: 14px; }
}

/* Wachtwoord tonen/verbergen */
.wachtwoord-rij { position: relative; }
.wachtwoord-rij input { padding-right: 70px; }
.toon-wachtwoord {
    position: absolute;
    right: 6px;
    top: 50%;
    transform: translateY(-50%);
    min-height: 40px;
    padding: 6px 12px;
    background: transparent;
    color: var(--mild);
    border: 0;
    box-shadow: none;
    font-size: 13px;
    font-weight: 600;
}
.toon-wachtwoord:hover { background: var(--oppervlak-2); color: var(--inkt); }

/* --- Voorraad: filterbalk + kleurbol --- */
.kleurbol {
    display: inline-block;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    margin-right: 8px;
    vertical-align: -2px;
    border: 2px solid #fff;
    box-shadow: 0 0 0 1px rgba(31, 24, 16, .25),
        inset 0 1px 1px rgba(255, 255, 255, .55),
        inset 0 -2px 3px rgba(31, 24, 16, .28);
}
.v-filterbalk, .g-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: flex-end;
    background: var(--oppervlak);
    border: 1px solid var(--lijn);
    border-radius: var(--radius);
    padding: 14px;
    margin: 4px 0 20px;
    box-shadow: var(--schaduw);
}
.v-filterbalk .segm, .g-filters .segm {
    display: flex;
    border: 1px solid var(--lijn-sterk);
    border-radius: 999px;
    overflow: hidden;
    background: #f5f3ee;
}
.v-filterbalk .segm a, .g-filters .segm a {
    padding: 10px 14px;
    font-size: 13px;
    font-weight: 600;
    color: var(--mild);
    text-decoration: none;
    white-space: nowrap;
    transition: background .12s ease, color .12s ease;
}
.v-filterbalk .segm a:hover, .g-filters .segm a:hover { color: var(--inkt); }
.v-filterbalk .segm a.actief, .g-filters .segm a.actief { background: var(--inkt); color: #fff; }
.v-filterbalk .segm a span, .g-filters .segm a span { font-weight: 400; opacity: .75; }
.v-filterbalk form, .v-filterform { display: contents; }
.v-rij { display: flex; flex-wrap: wrap; gap: 12px; align-items: flex-end; flex: 1 1 auto; }
.v-veld { display: flex; flex-direction: column; gap: 4px; }
.v-veld > label {
    margin: 0;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--mild);
}
.v-veld select, .v-veld input { width: auto; margin-top: 0; min-width: 150px; }
.v-veld input[type="search"] { min-width: 190px; }
.v-filterbalk button { margin-top: 0; width: auto; }
.wis-filters {
    font-size: 12.5px;
    font-weight: 600;
    text-decoration: none;
    padding: 9px 2px;
    white-space: nowrap;
    color: var(--mild);
}
.wis-filters:hover { color: var(--leer-donker); }

/* Filters inklapbaar op telefoon */
.filters-knop { display: none; }
.filters-inhoud { display: contents; }
@media (max-width: 899px) {
    .v-filterbalk .segm, .g-filters .segm { flex: 1 1 100%; justify-content: center; }
    .v-filterbalk .segm a, .g-filters .segm a { flex: 1; text-align: center; }
    .filters-knop {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        width: 100%;
        min-height: 46px;
        background: var(--oppervlak);
        border: 1px solid var(--lijn-sterk);
        border-radius: 999px;
        padding: 10px 16px;
        font-size: 13.5px;
        font-weight: 600;
        color: var(--tekst);
        cursor: pointer;
        box-shadow: none;
    }
    .filters-knop::after { content: "▾"; color: var(--mild); font-size: 14px; }
    .filterblok.open .filters-knop::after { content: "▴"; }
    .filters-knop:hover { background: var(--oppervlak-2); }
    .filters-tel {
        background: var(--leer-zacht);
        color: var(--leer-donker);
        border-radius: 999px;
        padding: 1px 9px;
        font-size: 11.5px;
        font-weight: 700;
        margin-left: auto;
    }
    .filters-inhoud { display: none; }
    .filterblok.open .filters-inhoud { display: block; }
    .v-veld { flex: 1 1 100%; }
    .v-veld select, .v-veld input, .v-veld input[type="search"] { width: 100%; min-width: 0; }
    .v-filterbalk button { width: 100%; }
    .wis-filters { text-align: center; }
}

/* --- Scanner --- */
.viewfinder {
    position: relative;
    background: #17140f;
    border: 1px solid #2b271f;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: var(--schaduw);
}
.viewfinder video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
}
.scan-hoek {
    position: absolute;
    inset: 12px;
    z-index: 2;
    pointer-events: none;
    border-radius: 10px;
    background:
        linear-gradient(#fff, #fff) top left / 32px 3px,
        linear-gradient(#fff, #fff) top left / 3px 32px,
        linear-gradient(#fff, #fff) top right / 32px 3px,
        linear-gradient(#fff, #fff) top right / 3px 32px,
        linear-gradient(#fff, #fff) bottom left / 32px 3px,
        linear-gradient(#fff, #fff) bottom left / 3px 32px,
        linear-gradient(#fff, #fff) bottom right / 32px 3px,
        linear-gradient(#fff, #fff) bottom right / 3px 32px;
    background-repeat: no-repeat;
}
.scan-status {
    padding: 10px 14px;
    font-size: 12.5px;
    color: #c4bba9;
    background: #17140f;
    border-top: 1px solid #2b271f;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
}
.scan-label {
    margin-top: 16px;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--mild);
}
.handmatig { display: flex; gap: 8px; margin-top: 6px; }
.handmatig input { flex: 1; margin-top: 0; }
.handmatig button { margin-top: 0; white-space: nowrap; }
@media (max-width: 480px) {
    .handmatig { flex-direction: column; }
    .handmatig button { width: 100%; }
}

/* --- Informatiekaart --- */
.kaart {
    background: var(--oppervlak);
    border: 1px solid var(--lijn);
    border-radius: var(--radius);
    padding: 18px 20px;
    margin: 16px 0;
    box-shadow: var(--schaduw);
}
.kaart h2 { margin: 0 0 8px; font-size: 16px; }
.kaart dl { margin: 4px 0; }
.kaart dt {
    font-weight: 600;
    font-size: 10.5px;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--mild);
    margin-top: 12px;
}
.kaart dd { margin: 2px 0 0; }
.kaart ul { padding-left: 22px; margin: 8px 0; }
.kaart li { margin: 6px 0; font-size: 14px; }
.kaart form {
    background: transparent;
    box-shadow: none;
    padding: 0;
    margin-top: 6px;
    max-width: none;
    border: 0;
}
.kaart .knoppen { margin-top: 16px; }
@media (max-width: 760px) {
    .kaart .knoppen a, .kaart .knoppen button { flex: 1 1 100%; }
}

/* --- Onthouden apparaten (Mijn account) --- */
.apparaat-rij {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 13px 0;
    border-bottom: 1px dashed var(--lijn);
}
.apparaat-rij:last-child { border-bottom: 0; }
.apparaat-rij form { margin: 0; padding: 0; box-shadow: none; border: 0; background: none; max-width: none; }
@media (max-width: 480px) {
    .apparaat-rij { flex-direction: column; align-items: stretch; }
    .apparaat-rij form button { width: 100%; }
}

/* --- Galerij --- */
.g-tel { color: var(--mild); font-size: 14px; }
.g-filterform {
    display: flex;
    gap: 8px;
    align-items: flex-end;
    flex-wrap: wrap;
    background: none;
    box-shadow: none;
    padding: 0;
    margin: 0;
    border: 0;
    max-width: none;
}
.g-filterform select, .g-filterform input { width: auto; margin-top: 0; min-width: 160px; }
.g-filterform input[type="search"] { flex: 1 1 200px; max-width: 320px; }
.g-filterform button { margin-top: 0; width: auto; }
.g-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 16px;
}
.g-kaart {
    display: flex;
    flex-direction: column;
    background: var(--oppervlak);
    border: 1px solid var(--lijn);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--schaduw);
    transition: transform .12s ease, box-shadow .12s ease;
}
.g-kaart:hover {
    transform: translateY(-2px);
    box-shadow: 0 1px 2px rgba(29, 26, 22, .05), 0 18px 40px -22px rgba(29, 26, 22, .32);
}
.g-staal { height: 170px; position: relative; }
.g-staal::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(255, 255, 255, .16), rgba(0, 0, 0, .10));
}
.g-foto { height: 170px; position: relative; background: #f1ede5; }
.g-foto img { width: 100%; height: 100%; object-fit: cover; display: block; }
.g-fotovorm {
    position: absolute;
    right: 10px;
    bottom: 10px;
    margin: 0;
    padding: 0;
    background: transparent;
    box-shadow: none;
    border: 0;
    max-width: none;
    z-index: 2;
}
.g-fotovorm button, .g-fotoknop {
    display: inline-block;
    padding: 8px 12px;
    background: rgba(29, 26, 22, .72);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, .5);
    border-radius: 999px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    box-shadow: 0 3px 10px rgba(0, 0, 0, .25);
    margin: 0;
    width: auto;
    min-height: 0;
}
.g-fotoknop { position: relative; overflow: hidden; }
.g-fotoknop input {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
}
.g-fotovorm button:hover, .g-fotoknop:hover { background: var(--leer-donker); }
.g-lichaam {
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 5px;
    flex: 1;
}
.g-code {
    font-family: "Poppins", system-ui, sans-serif;
    font-weight: 700;
    font-size: 14.5px;
    letter-spacing: .01em;
    color: var(--inkt);
    text-transform: uppercase;
}
.g-regel { font-size: 12.5px; }
.g-regel .lb { color: var(--mild); }
.g-voet {
    margin-top: auto;
    padding-top: 12px;
    display: flex;
    flex-direction: column;
    gap: 7px;
}
.g-voet .badge { align-self: flex-start; }
.g-voet a.g-regel { color: var(--mild); font-weight: 600; text-decoration: none; text-align: center; }
.g-voet a.g-regel:hover { color: var(--leer-donker); }
.g-voet button { width: 100%; margin: 0; }
details.g-meer { margin-top: 4px; font-size: 12.5px; }
details.g-meer summary { cursor: pointer; color: var(--leer-donker); font-weight: 600; }
details.g-meer dl { margin: 6px 0 2px; }
details.g-meer dt {
    font-size: 10.5px;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: var(--mild);
    margin-top: 6px;
}
details.g-meer dd { margin: 0 0 0 2px; font-size: 13px; }
.g-leeg {
    text-align: center;
    color: var(--mild);
    padding: 46px 12px;
    border: 1px dashed var(--lijn-sterk);
    border-radius: var(--radius);
    background: var(--oppervlak);
}
.g-verkocht-donker { color: var(--mild); font-size: 12.5px; }
@media (max-width: 899px) {
    .g-filterform { width: 100%; }
    .g-filterform select, .g-filterform input { flex: 1 1 100%; min-width: 0; }
    .g-filterform input[type="search"] { flex: 1 1 100%; max-width: none; }
    .g-filterform button { width: 100%; }
}

/* --- QR-labels --- */
.qr-aantal { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 10px; }
.qr-aantal label { margin: 0; }
.qr-aantal input { width: 110px; margin-top: 0; }
.qr-aantal button { margin-top: 0; }
.qr-sheet {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 16px;
    margin: 12px 0 26px;
}
.qr-label {
    background: var(--oppervlak);
    border: 1px solid #d9caa9;
    border-radius: 12px;
    padding: 12px 14px 10px;
    break-inside: avoid;
}
.qr-label .merk {
    font-size: 9px;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--leer);
    font-weight: 700;
}
.qr-label .code {
    font-family: Georgia, "Times New Roman", serif;
    font-size: 20px;
    font-weight: 700;
    color: var(--inkt);
    margin: 2px 0 6px;
}
.qr-label .qr-vak {
    display: flex;
    align-items: center;
    justify-content: center;
    max-width: 200px;
    margin: 0 auto 6px;
    background: #fff;
    border-radius: 8px;
    padding: 4px;
}
.qr-label .qr-vak svg { width: 100%; height: auto; display: block; }
.qr-label .invul {
    border: 1px dashed #cfbfa0;
    border-radius: 8px;
    padding: 2px 8px 6px;
}
.qr-label .invul div {
    font-size: 10.5px;
    color: var(--mild);
    border-bottom: 1px dotted #e0d5c2;
    padding: 3px 0 2px;
    min-height: 15px;
}
.qr-label .invul div:last-child { border-bottom: 0; }

/* --- Inloggen / 2FA (donker, zoals de hero van circuleather.com) --- */
body.login-pagina {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    max-width: none;
    padding: 20px calc(20px + env(safe-area-inset-right, 0px));
    background:
        radial-gradient(900px 520px at 12% -6%, rgba(238, 90, 72, .24), transparent 60%),
        radial-gradient(720px 520px at 108% 108%, rgba(201, 154, 63, .10), transparent 55%),
        #17130e;
}
.login-box {
    background: var(--oppervlak);
    padding: clamp(26px, 5vw, 38px);
    border-radius: 18px;
    max-width: 420px;
    width: 100%;
    box-shadow: 0 30px 80px -24px rgba(0, 0, 0, .65);
    border: 1px solid rgba(255, 255, 255, .1);
}
.login-box h1 { margin: 0 0 4px; font-size: 24px; }
.login-box form {
    background: transparent;
    box-shadow: none;
    padding: 0;
    max-width: none;
    border: 0;
}
.login-box button { margin-top: 18px; }
.login-box .voetnoot {
    color: var(--mild);
    font-size: 12.5px;
    margin-top: 18px;
    text-align: center;
}
.login-box .voetnoot a { text-decoration: none; }
.login-box .voetnoot a:hover { text-decoration: underline; }
.login-merk { text-align: center; margin-bottom: 22px; }
.login-merk .app-icoon {
    width: 64px;
    height: 64px;
    border-radius: 16px;
    margin: 0 auto 12px;
    background: #1d1a16;
    display: grid;
    place-items: center;
    font-size: 30px;
    box-shadow: 0 10px 26px -10px rgba(0, 0, 0, .5);
}
.login-merk .circu {
    font-weight: 700;
    font-size: 20px;
    letter-spacing: .05em;
    text-transform: uppercase;
    color: var(--inkt);
}
.login-merk .tagline {
    font-size: 10px;
    letter-spacing: .3em;
    text-transform: uppercase;
    color: var(--mild);
    margin-top: 4px;
}
.login-merk .hart { color: var(--leer); }
.login-box .qr-vak { display: flex; justify-content: center; margin: 14px 0 4px; }
.login-box .qr-vak svg { width: 210px; height: 210px; }
.geheim {
    text-align: center;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 14px;
    letter-spacing: .08em;
}
.rc-rij { display: flex; flex-wrap: wrap; gap: 6px; justify-content: center; }
.rc-rij span {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    background: #f4f1ea;
    border: 1px solid #e0dacd;
    padding: 4px 10px;
    border-radius: 8px;
    font-size: 14px;
}

/* --- Print (QR-labels) --- */
@media print {
    body { max-width: none; padding: 0; background: #fff; }
    .sitekop, .bodem-nav, .fab, .niet-printen, .msg, .fout, .errors { display: none !important; }
    .qr-sheet {
        margin: 0;
        gap: 5mm;
        grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    }
    .qr-label { border-radius: 3mm; }
    @page { size: A4 portrait; margin: 8mm; }
}